# LostLink AI — SMS Gateway Configuration

# Port to run on (Default: 5000)
PORT=5000

# 1. Fast2SMS API Key (Instant free signup at https://www.fast2sms.com)
# Delivers real SMS directly to any Indian (+91) phone number within 3 seconds.
FAST2SMS_API_KEY=your_fast2sms_api_key_here

# 2. Twilio (Alternative global carrier SMS)
# TWILIO_ACCOUNT_SID=your_twilio_account_sid
# TWILIO_AUTH_TOKEN=your_twilio_auth_token
# TWILIO_PHONE_NUMBER=your_twilio_phone_number
