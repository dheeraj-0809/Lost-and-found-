<?xml version="1.0" encoding="utf-8"?>
<!--
  LostLink AI — Splash Screen Drawable
  Shown instantly on app launch while WebView loads.
  Dark background with centred gold "LL" mark.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Dark background -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="135"
                android:startColor="#060D1A"
                android:endColor="#0A1628" />
        </shape>
    </item>

    <!-- Centred logo mark (approximate — vector would need API 23+) -->
    <item
        android:gravity="center"
        android:width="96dp"
        android:height="96dp">
        <shape android:shape="rectangle">
            <solid android:color="#1A3A6B" />
            <corners android:radius="22dp" />
            <stroke
                android:width="2dp"
                android:color="#F5B731" />
        </shape>
    </item>

</layer-list>
